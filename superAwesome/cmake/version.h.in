#pragma once

#define SUPER_AWESOME_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define SUPER_AWESOME_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define SUPER_AWESOME_VERSION_PATCH @PROJECT_VERSION_PATCH@

// Single comparable number
// e.g. 
//     0.1.0 -> 100
//     1.2.3 -> 10203
#define SUPER_AWESOME_VERSION \
    (SUPER_AWESOME_VERSION_MAJOR * 10000 + SUPER_AWESOME_VERSION_MINOR * 100 + SUPER_AWESOME_VERSION_PATCH)

#define SUPER_AWESOME_VERSION_STRING "@PROJECT_VERSION@"